[Unit]
Description=torgi.kz: парсинг etp.adilet (арестованное имущество)
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=torgi
WorkingDirectory=/opt/torgi/backend
EnvironmentFile=/etc/torgi/torgi.env
ExecStart=-/opt/torgi/backend/.venv/bin/python -m torgi.cli parse adilet
ExecStartPost=/bin/bash /opt/torgi/deploy/rebuild-site.sh
