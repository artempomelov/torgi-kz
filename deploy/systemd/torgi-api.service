[Unit]
Description=torgi.kz API (FastAPI)
After=network.target postgresql.service

[Service]
User=torgi
WorkingDirectory=/opt/torgi/backend
EnvironmentFile=/etc/torgi/torgi.env
ExecStart=/opt/torgi/backend/.venv/bin/uvicorn torgi.api:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
